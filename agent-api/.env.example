# anthropic 또는 openai
LLM_PROVIDER=openai

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_JUDGE_MODEL=claude-opus-5-5

# 공식 OpenAI를 쓸 경우
OPENAI_API_KEY=
# monogpt 등 OpenAI-호환 라우터를 쓸 경우 (backend/.env.example과 동일한 네이밍)
LLM_API_KEY=
LLM_BASE_URL=https://monogpt.kr/api/monorouter/v1/
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
