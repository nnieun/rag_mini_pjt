{
  "name": "agent-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=../backend/.env --env-file-if-exists=.env eval/run-eval.ts",
    "eval:judge": "tsx --env-file-if-exists=../backend/.env --env-file-if-exists=.env eval/run-judge-eval.ts",
    "eval:repeated": "tsx --env-file-if-exists=../backend/.env --env-file-if-exists=.env eval/run-repeated-eval.ts",
    "eval:generate": "tsx --env-file-if-exists=../backend/.env --env-file-if-exists=.env eval/generate-outputs.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
