LLM_BASE_URL=
LLM_API_KEY=

# 01_openai_test.ipynb 등 OpenAI API를 직접 호출하는 실습에서 사용
OPENAI_API_KEY=


# LANGSMITH_TRACING=
# LANGSMITH_ENDPOINT=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
# LANGSMITH_PROJECT=
# LANGSMITH_PROJECT=



ANTHROPIC_API_KEY=

# 쉼표로 구분한 프론트엔드 Origin 목록
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# PostgreSQL (Docker Compose 기본값과 동일)
POSTGRES_DB=ai_basic_law
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=local_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aiuser:local_dev_password@localhost:5432/ai_basic_law

# 완성된 RAG 답변을 PostgreSQL에 저장해 동일 질문의 토큰 사용을 줄임
RAG_ANSWER_CACHE_ENABLED=true
RAG_CACHE_TTL_DAYS=30
# 법령·프롬프트·검색 전략이 바뀌면 값을 올려 기존 캐시를 무효화
RAG_CACHE_VERSION=conditional-rerank-v10
RAG_CONDITIONAL_RERANK=true
RAG_LIST_CANDIDATE_K=20
RAG_RERANK_CANDIDATE_K=5
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_BATCH_SIZE=5
# 첫 정의 질문 대신 서버 시작 시 Qwen 모델을 GPU에 로딩
RAG_RERANK_PRELOAD=true
RAG_LLM_TOOL_ROUTING_ENABLED=true
RAG_LLM_ANALYSIS_ENABLED=true
RAG_GRAPH_TIMEOUT_SECONDS=120
DOCUMENT_MAX_BYTES=10485760

# 요청·모델·도구 호출을 request_runs/model_calls/tool_calls에 기록
RAG_TRACE_STORE_ENABLED=true
# MCP 서버에서 ask_law(LLM 답변) 도구를 노출할지 여부
RAG_MCP_ASK_ENABLED=true
# FastAPI /mcp (Streamable HTTP) 노출 여부와 보호 설정
RAG_MCP_HTTP_ENABLED=true
# 비워 두면 인증 없음. 외부에 열 때는 반드시 설정
RAG_MCP_TOKEN=
# DNS rebinding 방지용 허용 Host/Origin (쉼표 구분, "*"이면 검사 안 함)
RAG_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
RAG_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# thread_id별 대화 상태를 PostgreSQL(LangGraph 체크포인트)에 저장
RAG_CHECKPOINT_ENABLED=true
